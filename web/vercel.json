{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "http://100.56.250.136:8080/api/:path*"
    },
    {
      "source": "/actuator/:path*",
      "destination": "http://100.56.250.136:8080/actuator/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
