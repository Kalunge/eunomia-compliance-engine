# Copy this file to .env and fill in real values.
# .env is gitignored — never commit secrets.

# Database (Spring Boot's docker-compose integration provides these locally;
# Render injects them via the managed Postgres add-on)
DATABASE_URL=jdbc:postgresql://localhost:5434/eunomia
DATABASE_USERNAME=eunomia
DATABASE_PASSWORD=eunomia

# Server (Render sets this automatically in production)
PORT=8080

# Auth (Sprint 1+)
# Generate a strong secret: `openssl rand -base64 64`
JWT_SECRET=

# LLM providers (Sprint 1+)
# Groq is OpenAI-compatible; we call it through LangChain4j's open-ai adapter.
GROQ_API_KEY=
COHERE_API_KEY=
